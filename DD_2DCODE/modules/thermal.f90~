 module thermal
!*************************************************************************
   use variables
   use timestep
   implicit none
   save

   type (phys) :: tmp_gradr
   type (phys) :: tmp_gradt
   type (phys) :: tmp_gradp
   type (coll) :: tmp_C
   type (coll) :: tmp_NC
   
   double precision :: tmp_S(1:i_N)
   double precision :: tmp_bcRe(2,0:i_pH1)
   double precision :: tmp_bcIm(2,0:i_pH1)

   type (coll), private :: T
   type (coll), private :: NT
   
   type (lumesh), private :: XT(0:i_L1)
   type (mesh),   private :: YT(0:i_L1)

   type (coll), private :: cT
   
 contains

!------------------------------------------------------------------------
!  initialise temperature
!------------------------------------------------------------------------
   subroutine tmp_precompute()
      call var_coll_init(mes_oc,var_H, tmp_C)
      tmp_S    = 0d0
      tmp_BCRe = 0d0
      tmp_BCIm = 0d0
   end subroutine tmp_precompute


!------------------------------------------------------------------------
!  precomputation of codensity timestepping matrices
!------------------------------------------------------------------------
   subroutine tmp_matrices()
      integer :: l

      do l = 0, i_L1
         call tim_lumesh_X      ( mes_oc, 1d0, 1d0/d_PrT, l, XT(l) )
         call temp_bc_T         ( mes_oc, XC(l), l)
         call mes_lu_find       ( mes_oc, XC(l) )
         call tim_mesh_Y        ( mes_oc, 1d0, 1d0/d_PrT, l, YT(l) )
      end do

   end subroutine tmp_matrices


! - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
! i_cod_bc = 1  const T on ICB and CMB
!          = 2  const T on ICB, flux on CMB
!          = 3  const flux on ICB, T on CMB
!          = 4  const flux on ICB and CMB
! - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

   subroutine tmp_bc_T(D,A,l)
      type (rdom),   intent(in)  :: D
      type (lumesh), intent(out) :: A
      integer,       intent(in)  :: l
      integer :: j

      if(i_tmp_bc==1 .or. i_tmp_bc==2) then	
         A%M(2*i_KL+1,1)   = 1d0
      else
         do j = 1, 1+i_KL
            A%M(2*i_KL+1+1-j,j) = D%dr(1)%M(i_KL+1+1-j,j)
         end do
      end if
      
      if(i_tmp_bc==1 .or. i_tmp_bc==3) then	
         A%M(2*i_KL+1,D%N) = 1d0
      else
         do j = D%N-i_KL, D%N
            A%M(2*i_KL+1+D%N-j,j) = D%dr(1)%M(i_KL+1+D%N-j,j)
         end do
      end if
! # Rob (14/02/12): Fix temperature so that the code knows what the temperature is when both boundaries are fixed flux
! This is done by setting the average (i.e. l=0) mode as a BC on T rather than on dT/dr
      if((i_tmp_bc==4) .and. (l==0)) then
!         A%M(2*i_KL+1,D%N)   = 1d0
         do j = 1, 1+i_KL
            A%M(2*i_KL+1+1-j,j) = 0d0
         end do
         A%M(2*i_KL+1,1)   = 1d0
      endif
! ###
      
   end subroutine tmp_bc_T


!-------------------------------------------------------------------------
!  set the RHS for the boundary condition = 0
!-------------------------------------------------------------------------
   subroutine tmp_setbc(a)
      type (coll), intent(inout) :: a
      integer :: nh, n
      n = a%D%N
      do nh = 0, a%H%pH1
         a%Re( 1, nh ) = tmp_bcRe(1,nh)
         a%Re( n, nh ) = tmp_bcRe(2,nh)
         a%Im( 1, nh ) = tmp_bcIm(1,nh)
         a%Im( n, nh ) = tmp_bcIm(2,nh)
      end do
   end subroutine tmp_setbc


!-------------------------------------------------------------------------
!  find flux at outer boundary for no flow:  dr C  evaluated at ro, 
!  where C solves   - q ( drr + 2/r dr ) C = S  plus boundary conditions.
!-------------------------------------------------------------------------
   subroutine tmp_cmbflux(q, flx)
      double precision, intent(in)  :: q
      double precision, intent(out) :: flx
      double precision :: S(mes_oc%N)
      type (lumesh) :: A
      integer :: N, j, info
      call tim_lumesh_X ( mes_oc, 0d0, q/d_implicit, 0, A )
      call temp_bc_T     ( mes_oc, A, 0)
      call mes_lu_find  ( mes_oc, A )
      N = mes_oc%N
      S = tmp_S
      S(1) = tmp_bcRe(1,0)
      S(N) = tmp_bcRe(2,0)
      call dgbtrs('N', N, i_KL, i_KL, 1, A%M, 3*i_KL+1,  &
                   A%ipiv, S, N, info )
      if(info/=0) stop 'tmp_cmbflux'
      flx = 0d0
      do j = N-i_KL, N
         flx = flx  +  S(j) * mes_oc%dr(1)%M(i_KL+1+N-j,j)
      end do
   end subroutine tmp_cmbflux


!------------------------------------------------------------------------
!  cC -> (grad C)r,t,p  phys 
!------------------------------------------------------------------------
   subroutine tmp_transform()
      use transform
      type (spec) :: sT, sT_

      call var_coll_meshmult(mes_oc%dr(1),tmp_C, cT)
      call var_coll2spec(tmp_C,sT, c2=cT,s2=sT_) 

      call tra_spec2phys(sT_, tmp_gradr)

      call tra_grad(sT, tmp_gradt,tmp_gradp)
      
   end subroutine tmp_transform


!------------------------------------------------------------------------
!  N  := cN,                         save N at time t
!  C  := Y cC + cN,   C := invX C,   get prediction C*
!  cC := C                           copy prediction
!------------------------------------------------------------------------
   subroutine tmp_predictor()

      call var_coll_copy (tmp_NC, NT)
      call tim_multY     (.true.,YT,tmp_T,tmp_NT, T)
      call cod_setbc     (T)
      call tim_invX      (.true. ,XT, T)
      call var_coll_copy (T, tmp_T)
      
   end subroutine tmp_predictor
   
   
!------------------------------------------------------------------------
!  C  := c (cN - N),   	using N* get nlin correction
!  N  := cN		save last N
!  C  := invX C,   	get correction to C, correction has 0 bc
!  cC := cC + C		update correction
!------------------------------------------------------------------------
   subroutine tmp_corrector()

      call tim_nlincorr (tmp_NT,NT, T)
      call var_coll_copy(tmp_NT,NT)
      call tim_zerobc   (T)
      call tim_invX     (.true. ,XT, T)
      call tim_addcorr  (T, tmp_T)

   end subroutine tmp_corrector
   
   
!*************************************************************************
 end module thermal
!*************************************************************************
